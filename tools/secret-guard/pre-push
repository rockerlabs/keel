#!/usr/bin/env bash
# Keel secret-guard — pre-push hook. The hard outward boundary: scan the commits being pushed.
# Reads stdin lines: <local ref> <local sha> <remote ref> <remote sha>
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
scan="$here/secret-scan.sh"
[ -x "$scan" ] || scan="$(command -v secret-scan.sh || true)"
if [ -z "${scan:-}" ] || [ ! -x "$scan" ]; then
  echo "secret-guard: scanner not found next to hook" >&2
  exit 1
fi
# shellcheck source=tools/secret-guard/range-lib.sh
. "$here/range-lib.sh"

status=0
while read -r _localref localsha _remoteref remotesha; do
  secret_guard_is_zero_sha "$localsha" && continue    # branch deletion — nothing to scan
  range="$(resolve_range_local "$remotesha" "$localsha")"
  # dir #518: SECRET_SCAN_LOCAL_PUSH tells secret-scan.sh's --range allowlist-baseline resolution it
  # is safe to ALSO exclude anything reachable via a remote-tracking ref when deciding what already-
  # known content to trust — safe ONLY here, because this hook runs BEFORE the push transfers, so the
  # range's own newly-introduced TIP is, by construction, not yet reachable from any local remote-
  # tracking ref — interior commits brought in by a `git merge origin/main` commonly already ARE, and
  # it is that asymmetry the exclusion relies on (dir #569).
  # ci-scan.sh must NEVER set this (its own resolve_range_ci docstring already explains why: a CI
  # checkout runs AFTER the push landed, so the range's own tip is typically already remote-known,
  # and excluding remote-known content there would collapse the whole baseline to nothing).
  SECRET_SCAN_LOCAL_PUSH=1 "$scan" --range "$range" || status=1
done
exit "$status"
