#!/bin/sh
# keel — the one entry point for Keel's lifecycle tools. A THIN dispatcher: every verb is a rename
# of a script that already exists (install.sh, tools/*.sh), so this file adds no capability of its
# own except `uninstall`, `version`, and `help`. It resolves ITS OWN checkout by following the
# symlink install.sh puts on your PATH, then runs the sibling script — so `keel <verb>` works from
# ANY cwd, which the bare `tools/*.sh` paths (unresolvable from a user's own project) never did
# (backlog dir #4/D1 — the felt reason this CLI exists, hit live with the first external adopter).
#
# Verbs:
#   keel install [--link] [--no-git]  -> install.sh     bootstrap / linked wiring into your home
#   keel sync                  -> git pull + install.sh  refresh a linked install after a release
#   keel doctor [--install]    -> tools/doctor.sh        audit a project, or the install itself
#   keel audit                 -> tools/public-audit.sh  leak-surface scan before going public
#   keel init [DIR]            -> tools/init-project.sh  scaffold a project's knowledge base
#   keel check <cmd...>        -> tools/keel-check.sh    run a check through the stop-mode floor
#   keel uninstall             -> uninstall.sh           reverse install.sh (backs up what it removes)
#   keel version               -> the checkout's version (git describe)
#   keel help | -h | --help    -> this usage
#
# Zero-dependency POSIX sh. A child's exit code passes straight through (via exec), so callers and CI
# see the real result. An unknown verb prints usage to stderr and exits 2.
set -eu

prog="keel"

# --- resolve this script's real path, following symlinks (macOS has no `readlink -f`) -----------
# $0 is however we were invoked: the PATH symlink install.sh wires (<home>/bin/keel -> <checkout>/keel),
# a relative ./keel, or a bare `keel` found on PATH. Normalise all three to the physical file, then take
# its directory as the checkout. `pwd -P` collapses any symlinked parent dirs too. No `--` on readlink /
# command below: our values never start with `-`, and dropping it sidesteps a busybox portability wart.
self="$0"
case "$self" in
  */*) : ;;                              # already has a path component
  *) self="$(command -v "$self" || true)"  # bare name -> locate on PATH
     [ -n "$self" ] || { echo "$prog: cannot locate my own path" >&2; exit 1; } ;;
esac
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *)  self="$(dirname "$self")/$link" ;;
  esac
done
CHECKOUT="$(cd "$(dirname "$self")" && pwd -P)"

# Sanity: the checkout must carry the scripts we dispatch to. Guards against a stray `keel` COPIED
# (not symlinked) somewhere its siblings don't exist — a clear error beats a confusing "no such file".
if [ ! -f "$CHECKOUT/install.sh" ] || [ ! -d "$CHECKOUT/tools" ]; then
  # The re-wire has to target the home this CLI was installed into, not wherever a bare re-run would
  # land: bin/keel sits one level under it, so $0's grandparent names it. Same rule as install.sh's
  # home_flag and doctor's ihome_flag — dir #98's defect class is "advice that can't reach the install
  # it is about", and a broken CLI in a retargeted home is exactly that case.
  keel_home="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd -P)" || keel_home=""
  home_flag=""; mode_flag=""; default_leaf=".claude"
  if [ -n "$keel_home" ]; then
    # MODE as well as home — the half a home flag can't see. The bin/keel wiring is not mode-gated,
    # so a --codex install has this CLI too; advising a bare `install.sh --home <codex-home>` would
    # re-run Claude copy mode into it and write the wrong context file. dir #125: prefer the recorded
    # install manifest — exact, not guessed — when exactly one mode's manifest is present at the home;
    # a both-modes home (dir #124) falls to claude, same as the sniff below picks in that case.
    if [ -f "$keel_home/.keel/install-manifest.codex" ] && [ ! -f "$keel_home/.keel/install-manifest.claude" ]; then
      mode_flag=" --codex"; default_leaf=".codex"
    elif [ ! -f "$keel_home/.keel/install-manifest.claude" ] && [ ! -f "$keel_home/.keel/install-manifest.codex" ]; then
      # dir #150 audit (kept, not removed — dir #125's own design note, BACKLOG.md, named this site an
      # explicit exception: "keep the sniff as legacy"): unlike uninstall.sh's manifest-required
      # refusal, this is advisory recovery text for an already-broken CLI (the checkout it points at is
      # gone), never a destructive action — a best-effort guess here is more useful than a flat "could
      # be either mode" shrug, and going silently to the claude default without ANY signal would be
      # exactly the confidently-wrong guess dir #150's own "never a silent behavior change" bar forbids
      # (a --codex home with no manifest would otherwise be told to re-run Claude copy mode into it).
      # Read off the home itself, since the CLI has no other record of it: a --codex install writes
      # AGENTS.md and no CLAUDE.md. The default it compares against moves with the mode for the same
      # reason.
      if [ -f "$keel_home/AGENTS.md" ] && [ ! -f "$keel_home/CLAUDE.md" ]; then
        mode_flag=" --codex"; default_leaf=".codex"
      fi
    fi
    # Compare against the default BOTH raw and physically resolved: $keel_home came from `pwd -P`, so
    # a $HOME reached through a symlink (/tmp → /private/tmp on macOS) would otherwise differ from an
    # identical default and print a --home nobody needs.
    default_home="${KEEL_HOME:-${HOME:-}/$default_leaf}"
    default_home_p="$(cd "$default_home" 2>/dev/null && pwd -P)" || default_home_p="$default_home"
    if [ "$keel_home" != "$default_home" ] && [ "$keel_home" != "$default_home_p" ]; then
      home_flag=" --home \"$keel_home\""
    fi
  fi
  echo "$prog: cannot find the Keel checkout next to me ($CHECKOUT has no install script or tools/)." >&2
  echo "      keel must stay a symlink into its checkout — re-run install.sh$mode_flag$home_flag to re-wire it (add --force if a real file, not a symlink, sits there — it gets backed up first)." >&2
  exit 1
fi

usage() {
  cat <<EOF
$prog — one entry point for Keel's lifecycle tools (checkout: $CHECKOUT)

Usage: $prog <command> [args...]

Commands:
  install [--link]     install/refresh Keel into your harness home (--link: wire by symlink;
                       --no-git trims the code/git rails for a git-less machine, --with-git restores)
  sync                 refresh a linked install: git pull in the checkout, then re-wire
  doctor [--install]   audit a project's KB baseline (--install: audit the install itself)
  audit                scan the leak surface before pushing public
  init [DIR]           scaffold a project's Keel knowledge base
  check <cmd...>       run a verification command through the stop-mode floor
  uninstall            reverse install.sh (backs up anything it removes)
  version              print the checkout's version
  help                 show this help

Every command forwards its arguments and exit code to the underlying tool.
EOF
}

[ "$#" -ge 1 ] || { usage >&2; exit 2; }

cmd="$1"
shift
case "$cmd" in
  install)   exec "$CHECKOUT/install.sh" "$@" ;;
  sync)
    # Refresh semantics for a linked install: pull the checkout, then re-run install — which is sticky
    # (it detects a linked home and re-wires in linked mode, picking up anything a release ADDED; a pull
    # refreshes content, not composition). Pull is best-effort: a detached/dirty/offline checkout still
    # gets the re-wire rather than aborting the whole refresh.
    if ! git -C "$CHECKOUT" pull --ff-only; then
      echo "$prog sync: git pull did not fast-forward — re-wiring from the checkout as-is." >&2
    fi
    exec "$CHECKOUT/install.sh" "$@" ;;
  doctor)    exec "$CHECKOUT/tools/doctor.sh" "$@" ;;
  audit)     exec "$CHECKOUT/tools/public-audit.sh" "$@" ;;
  init)      exec "$CHECKOUT/tools/init-project.sh" "$@" ;;
  check)     exec "$CHECKOUT/tools/keel-check.sh" "$@" ;;
  uninstall) exec "$CHECKOUT/uninstall.sh" "$@" ;;
  version)
    v="$(git -C "$CHECKOUT" describe --tags --always --dirty 2>/dev/null || true)"
    [ -n "$v" ] || v="unknown"
    echo "keel $v ($CHECKOUT)" ;;
  help|-h|--help) usage ;;
  *) echo "$prog: unknown command '$cmd' (try '$prog help')" >&2; usage >&2; exit 2 ;;
esac
